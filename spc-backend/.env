GITLAB_URL=https://gitlab.com/api/v4
GITLAB_TOKEN_URL=https://gitlab.com/oauth/token
S3_BUCKET=your-bucket
S3_REGION=us-east-1
LOG_LEVEL=INFO
PORT=8000
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=gloas-
GITLAB_REDIRECT_URI=http://localhost:8000/callback
S3_ENDPOINT_URL=https://your-private-s3-endpoint.company.com
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=your-templates-bucket
S3_REGION=us-east-1

# Environment-specific OpenShift configuration
OS_ENV_A_TOKEN=your_production_a_token_here
OS_ENV_A_SERVER=https://prod-a.openshift.example.com

OS_ENV_B_TOKEN=your_production_b_token_here  
OS_ENV_B_SERVER=https://prod-b.openshift.example.com

OS_ENV_C_TOKEN=your_test_c_token_here
OS_ENV_C_SERVER=https://test-c.openshift.example.com

OS_ENV_D_TOKEN=your_staging_d_token_here
OS_ENV_D_SERVER=https://staging-d.openshift.example.com
