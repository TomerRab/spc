### Installation

```bash
# Clone the repository
git clone https://gitlab.com/your-group/{{ repo_name }}.git
cd {{ repo_name }}

{% if stack == "python" %}
# Create virtual environment
python -m venv venv
source venv/bin/activate  # On Windows: venv\Scripts\activate

# Install dependencies
pip install -r requirements.txt

# Run the application
python main.py
{% elif stack == "node" %}
# Install dependencies
npm install

# Start development server
npm run dev

# Build for production
npm run build
{% elif stack == "maven" %}
# Build the project
mvn clean install

# Run the application
mvn spring-boot:run
{% elif stack == "dotnet" %}
# Restore dependencies
dotnet restore

# Build the project
dotnet build

# Run the application
dotnet run
{% else %}
# Install dependencies
make install

# Run the application
make run
{% endif %}
```

